# Database Configuration
DB_URL=jdbc:mysql://localhost:3306/lending_dashboard?createDatabaseIfNotExist=true
DB_USERNAME=root
DB_PASSWORD=your_password_here

# Server Configuration
SERVER_PORT=8080

# JWT Configuration
JWT_SECRET=replace-with-a-base64-encoded-32-byte-key

# CORS Configuration
CORS_ORIGINS=http://localhost:4200

# Mail Configuration
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_APP_PASSWORD=your_app_password_here

# Gmail IMAP Configuration (for email reconciliation)
GMAIL_IMAP_HOST=imap.gmail.com
GMAIL_IMAP_PORT=993
GMAIL_IMAP_USERNAME=your_email@gmail.com
GMAIL_IMAP_APP_PASSWORD=your_app_password_here
GMAIL_IMAP_FOLDER=INBOX

# Email Reconciliation Configuration
EMAIL_RECONCILIATION_ENABLED=false
EMAIL_RECONCILIATION_LOOKBACK_DAYS=10
EMAIL_RECONCILIATION_CRON=0 0 23 * * *
EMAIL_RECONCILIATION_ZONE=Asia/Kolkata
LENDENCLUB_EMAIL_SENDER=noreply@lendenclub.com
BANK_EMAIL_SENDERS=noreply@jana.bank.in,noreply@slice.bank.in
EMAIL_CREDENTIAL_ENCRYPTION_KEY=

# Upload Notification
UPLOAD_NOTIFICATION_ENABLED=false
UPLOAD_NOTIFICATION_FROM=noreply@yourapp.com

# Risk-engine borrower lookup (optional)
BORROWER_LOOKUP_URL=http://localhost:8081/api/borrowers/{loanId}
RISK_ENGINE_API_KEY=replace-with-the-same-key-configured-in-the-risk-engine
RISK_ENGINE_AUTH_HEADER=X-API-Key
